# Python cache
__pycache__/
*.py[cod]
*.pyc

# Data
data/raw/*             # ignore everything in raw/
!data/raw/.gitkeep     # ...but keep the placeholder

data/clean/*           # ignore everything in clean/
!data/clean/.gitkeep   # ...but keep the placeholder

# Optional extra patterns (keep if you like)
data/clean/*.tmp
*.log
/data/raw/*.csv
/data/clean/*.csv
/data/*.log


# Browsers (if used later)
playwright/.cache/

# Editors / IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Playwright (if used later)
playwright/.cache/

# Testing caches
.mypy_cache/

# Archives
*.zip
*.tar.gz
*.tgz

# Virtual env & editor junk
.venv/

# Test/artefacts
data/**/*.csv
data/**/*.json
data/**/*.log

